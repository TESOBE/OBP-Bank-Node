.claude/

# Rust build artifacts
/target
**/*.rs.bk

# Local secrets / wallet keys
/secrets/
*.skey

# Commercially sensitive docs — never track
/DO_NOT_COMMIT/

# Runtime state — SQLite outbox/evidence/settlement databases. Never track:
# outbox.db holds the off-chain commitment salts and full A1.1 payloads,
# evidence.db holds salt+preimage+originator PII (Travel Rule data).
/outbox/
*.db
*.db-wal
*.db-shm

# Round-trip test runtime output (CBS receipts) and minted DirectLogin tokens
dev/data/
dev/env.sh
dev/__pycache__/

# Runtime pid file
node.pid

# Per-machine settings for dev/ (Consumer secrets, admin login), and their backups
dev/local.env
dev/local.env.bak.*
