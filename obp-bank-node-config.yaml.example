# OBP Bank Node — example configuration.
# Provided pre-populated by the OBP API operator at registration; replace placeholders.

obp_bank_node:
  port: 8088
  local_secret: "change-me-on-first-run"

bank:
  bank_id: "ke.01.kcs"
  account_id: "7bc9a8e4-5d02-40e3-b129-1c3bf89de9f1"
  view_id: "owner"

obp_api:
  base_url: "http://localhost:8080"
  # OAuth2 client-credentials (machine-to-machine). Leave empty to run
  # unauthenticated against a local/mock OBP-API.
  token_url: "http://localhost:8080/oauth2/token"
  client_id: "provided-at-registration"
  client_secret: "provided-at-registration"
  # scope: "..."          # optional
  # Alternative to client-credentials: a pre-obtained DirectLogin token.
  # direct_login_token: ""

rabbitmq:
  # Interface C — inbound from OBP-API. Off by default so the node boots without
  # a broker; set true to start the consumer.
  enabled: false
  # Defaults match the rabbitmq:3-management Docker image:
  #   AMQP        amqp://guest:guest@localhost:5672/
  #   Management  http://localhost:15672  (guest / guest)
  host: "localhost"
  port: 5672
  username: "guest"
  password: "guest"
  # Per-bank isolation: each bank consumes on its own vhost, e.g. /bank.ke.01.kcs
  virtual_host: "/bank.ke.01.kcs"
  request_queue: "obp_rpc_queue"

# The signing key is the only wallet input — the verification key and wallet
# address are derived from it. All cardano fields are optional; the defaults
# match the bundled Cardano container and the key generated at installation,
# so `type: "cardano"` alone is a complete production config.
#
# Do NOT set a network here. The Cardano network is fixed by the image you
# deploy (obp-bank-node:preprod / obp-bank-node:mainnet); the node refuses to
# start if this file names a different one. Only a native (non-Docker) dev
# build reads a `network` field from YAML.
blockchain:
  type: "cardano"                          # mock | cardano
  # cardano:
  #   ogmios_url: "ws://localhost:1337"    # override only for a managed provider
  #   wallet_skey_path: "./secrets/cardano.skey"

cbs_delivery:
  mode: "webhook_obp"     # webhook_obp | webhook_iso20022 | database | file

  webhook:
    url: "http://bank-cbs/api/credit-notifications"
    timeout_seconds: 30

  database:
    host: "cbs-db.bank.local"
    port: 5432
    name: "cbs_staging"
    username: "obp_writer"
    password: "..."
    table: "obp_credit_instructions"
    driver: "postgresql"

  file:
    drop_path: "/shared/credit-notifications/inbound/"
    acknowledgement_path: "/shared/credit-notifications/acknowledged/"
    format: "json"

telemetry:
  type: "prometheus"
  port: 9090
  log_level: "INFO"

dashboard:
  enabled: false
  bind_address: "127.0.0.1"
  port: 8081
  auth:
    enabled: true
    username: "admin"
    password: "change-me"

outbox:
  path: "/app/outbox/obp-bank-node.db"

# Beneficiary-side evidence store: received credit notifications + the salts that
# let this bank open Bank A's on-chain commitment in a dispute (commit–reveal).
evidence:
  path: "/app/outbox/evidence.db"
