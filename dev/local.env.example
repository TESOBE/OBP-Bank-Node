# Per-machine settings for the dev/ scripts. Copy to dev/local.env (gitignored) and fill in.
# dev/create_consumers.sh writes the Consumer values below for you; the rest you set by hand.

# OBP-API's props file. create_consumers.sh reads the oidc_operator_* login from it, and db.url
# (OBP-API's Postgres) to recover the key and secret of a Consumer that already exists.
RT_OBP_PROPS_FILE=/path/to/OBP-API/obp-api/src/main/resources/props/default.props

# An OBP-API super admin (a user listed in super_admin_user_ids). setup_obp.sh logs in as this
# user to create the banks, accounts, views, Scopes and roles.
RT_SA_USER=
RT_SA_PASS=

# Optional: OBP-API's address (default http://localhost:8080).
# RT_OBP_URL=http://localhost:8080

# Written by dev/create_consumers.sh:
# Consumers 'obp-bank-node-a' / 'obp-bank-node-b': the nodes, as Platform Apps. They log in to
# OBP-OIDC with OAuth2 client credentials (the client id is the Consumer key).
NODE_A_CLIENT_ID=
NODE_A_CLIENT_SECRET=
NODE_A_CONSUMER_ID=
NODE_B_CLIENT_ID=
NODE_B_CLIENT_SECRET=
NODE_B_CONSUMER_ID=
# Consumer 'obp-bank-node-roundtrip': the DirectLogin consumer key the setup scripts' admin logs in with.
RT_CONSUMER_KEY=
# Consumers 'obp-bank-node-app-a' / 'obp-bank-node-app-b': the UIs' /setup page login (OIDC).
UI_A_OAUTH_CLIENT_ID=
UI_A_OAUTH_CLIENT_SECRET=
UI_B_OAUTH_CLIENT_ID=
UI_B_OAUTH_CLIENT_SECRET=
