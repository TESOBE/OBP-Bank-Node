# Per-machine settings for the dev/ scripts. Copy to dev/local.env (gitignored) and fill in.
# dev/create_consumers.sh writes the Consumer values below for you; the rest you set by hand.

# OBP-API's props file. setup_obp.sh and create_consumers.sh read db.url from it (to reach
# OBP-API's Postgres) and create_consumers.sh reads the oidc_operator_* login from it.
RT_OBP_PROPS_FILE=/path/to/OBP-API/obp-api/src/main/resources/props/default.props

# An OBP-API super admin (a user listed in super_admin_user_ids, or one holding
# CanCreateEntitlementAtAnyBank). setup_obp.sh logs in as this user to create the banks,
# users, accounts and roles.
RT_SA_USER=
RT_SA_PASS=

# Optional: OBP-API's address (default http://localhost:8080).
# RT_OBP_URL=http://localhost:8080

# Optional: OBP-API's Postgres database and user. By default they are read from db.url.
# RT_PG_DB=
# RT_PG_USER=

# Written by dev/create_consumers.sh:
# Consumer 'obp-bank-node-roundtrip': the DirectLogin consumer key the node service users log in with.
RT_CONSUMER_KEY=
# Consumers 'obp-bank-node-app-a' / 'obp-bank-node-app-b': the UIs' /setup page login (OIDC).
UI_A_OAUTH_CLIENT_ID=
UI_A_OAUTH_CLIENT_SECRET=
UI_B_OAUTH_CLIENT_ID=
UI_B_OAUTH_CLIENT_SECRET=
